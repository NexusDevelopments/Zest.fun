# Next.js Environment Variables
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Options: devnet, testnet, mainnet-beta, localhost

# Solana RPC Endpoint (optional - uses public endpoint if not set)
# NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# Admin Wallet Public Key
# NEXT_PUBLIC_ADMIN_WALLET=YOUR_ADMIN_WALLET_PUBLIC_KEY_HERE

# Program ID (after deploying your Anchor program)
# NEXT_PUBLIC_PROGRAM_ID=YOUR_PROGRAM_ID_HERE
